# API 基础地址
EXPO_PUBLIC_API_URL=https://api.example.com
-e
# Google Sign-In Client IDs
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=xxxx

# Debug: TTS WebSocket pipeline 落盘开关
# 是否将 WS 收到的 PCM chunk + 元数据写入缓存目录 (WAV + JSON)。
# 仅用于设备调试比对服务端返回完整性;生产保持 false。
# 可选值: true | false (默认 false)
EXPO_PUBLIC_DEBUG_TTS_PIPELINE_DUMP=false