  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios  --device",
    "web": "expo start --web",
    "android:clean": "expo prebuild --platform android --clean",
    "android:setup-sdk": "bash scripts/setup-android-sdk.sh",
    "build:android": "bash scripts/build-android-release.sh",
    "build:ios": "bash scripts/build-ios-release.sh",
    "build:web": "expo export --platform web",
    "testflight:upload": "bash scripts/upload-testflight.sh",
    "testflight": "pnpm run build:ios && pnpm run testflight:upload",
    "lint": "tsc --noEmit && eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "doctor": "expo doctor",
    "generate-licenses": "node scripts/generate-licenses.mjs",
    "eas-build-post-install": "node scripts/generate-licenses.mjs",
    "clean": "bash ../../scripts/clean.sh",
    "clean:keep": "bash ../../scripts/clean.sh --keep",
    "clean:full": "bash ../../scripts/clean.sh"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sharing",
          "expo-media-library"
        ]
      },
      "apple": {
        "buildFromSource": [
          "expo-camera",
          "expo-media-library"
        ]
      }
    }
  },
  "private": true
}
